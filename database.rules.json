{
  "rules": {
    "users": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || !data.exists())"
      }
    },
    "donors": {
      ".read": true,
      ".write": true,
      ".indexOn": ["bloodGroup", "city", "email", "phone", "donationCount", "timesDonated", "status"]
    },
    "organ_donors": {
      ".read": true,
      ".write": true,
      ".indexOn": ["city", "email", "phone", "organsPledged"]
    },
    "blood_requests": {
      ".read": true,
      ".indexOn": ["bloodGroup", "city", "status", "timestamp", "userId"],
      "$requestId": {
        ".write": "(!data.exists() && auth != null) || (data.exists() && auth != null && (data.child('userId').val() === auth.uid || data.child('userEmail').val() === auth.token.email || root.child('sub_admins').child(auth.uid).exists() || root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'jogumuralikrishna55@gmail.com'))"
      }
    },
    "partner_hospitals": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": ["city", "status"]
    },
    "admin_audit_logs": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp", "action", "adminEmail"]
    },
    "sub_admins": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["email", "status"]
    },
    "hospital_communications": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["hospitalId", "status", "timestamp"]
    },
    "profile_change_requests": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "account_change_requests": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "contact_requests": {
      ".read": "auth != null",
      ".write": true
    },
    "messages": {
      ".read": "auth != null",
      ".write": true
    },
    "referrals": {
      ".read": true,
      ".write": true
    },
    "referral_codes": {
      ".read": true,
      ".write": true
    }
  }
}
