# =======================================================
# LifeSaver-Care Production Environment Configuration
# =======================================================

# Server Environment
NODE_ENV=production
PORT=3000

# Authentication Secret
JWT_SECRET=lifesaver-secure-database-key-2026-production

# Custom Domain Configuration
FRONTEND_URL=https://lifesaver.qd.je
API_URL=https://lifesaver.qd.je

# Free Cloud PostgreSQL Database Configuration:
# Choose any free PostgreSQL provider (Neon, Supabase, Render, Railway):
#
# Option A: Neon (Free Serverless PostgreSQL - https://neon.tech) - RECOMMENDED FOR VERCEL
# DATABASE_URL=postgresql://user:password@ep-cool-flower-123456.us-east-2.aws.neon.tech/lifesaver?sslmode=require
#
# Option B: Supabase (Free PostgreSQL - https://supabase.com)
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#
# Option C: Render / Railway / Aiven (Free tiers)
# DATABASE_URL=postgresql://user:password@hostname:5432/lifesaver
#
# DB_SSL=true
