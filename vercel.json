{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/google7f6c6857dafe10a0.html", "destination": "/google7f6c6857dafe10a0.html" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sw.js", "destination": "/sw.js" }
